# Copy this file to .env.local and fill in the values.
#
#   cp .env.example .env.local
#
# .env.local should point at your TEST Supabase project, never production, so
# that local development cannot touch real game data. Production values live in
# the Railway service variables.
#
# Both are NEXT_PUBLIC_ because the browser talks to Supabase directly. They are
# inlined into the JavaScript bundle at build time and are not secrets — the
# anon key is designed to be public. Access is controlled by row level security
# in Supabase, not by hiding this key.

NEXT_PUBLIC_SUPABASE_URL=https://your-test-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-test-project-anon-key
